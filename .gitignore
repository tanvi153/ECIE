# ==============================================================================
*.csv
*.tsv
*.parquet
data/raw/*.csv
data/processed/*.csv
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/products_sample.csv
!data/powerbi/*.csv
!data/powerbi/*.tsv

