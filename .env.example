# ==============================================================================
# ECIE Environment Configuration Template
# Copy this file to '.env' and update values as needed for your local environment:
#   cp .env.example .env
# ==============================================================================

# Database Connection (PostgreSQL)
DB_USER=postgres
DB_PASS=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecie_project_db

# Optional direct connection string override:
# DATABASE_URL=postgresql+psycopg2://postgres:your_password_here@localhost:5432/ecie_project_db

# MLflow Experiment Tracking
MLFLOW_EXPERIMENT_NAME=ECIE_Sentiment_Analysis
# MLFLOW_TRACKING_URI=sqlite:///experiments/mlflow.db

# Custom Data Directory (Optional - defaults to data/ or data/raw)
# DATA_DIR=/path/to/data
# DATA_RAW_DIR=/path/to/data/raw
